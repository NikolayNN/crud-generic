{
  "permissions": {
    "allow": [
      "Bash(mise exec -- mvn:*)",
      "Bash(mise exec -- java:*)",
      "Bash(mise ls:*)",
      "Bash(./mvnw:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git ls-files:*)"
    ],
    "deny": [
      "Bash(mvn deploy:*)",
      "Bash(git tag:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/guard-bash.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
